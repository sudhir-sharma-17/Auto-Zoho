# Backend App Server Configuration
HOST=0.0.0.0
PORT=8000
ENV=production

# Database Settings (PostgreSQL in production, SQLite in local dev)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Storage Directories (Ephemeral in Render)
UPLOAD_DIR=./data/uploads
LOGS_DIR=./logs

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=https://your-app-name.onrender.com

# Zoho Developer Console Integration
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=https://your-app-name.onrender.com/api/zoho/callback

# Zoho endpoints depending on data center domain (.com, .in, .eu)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com/expense/v1

# Cryptographic token encryption key (32-byte urlsafe base64 key)
ZOHO_TOKEN_ENCRYPTION_KEY=generate_a_random_encryption_key

# Single Admin Authentication
AUTO_ZOHO_ADMIN_USERNAME=your_admin_username
AUTO_ZOHO_ADMIN_EMAIL=your_recovery_email@example.com
ADMIN_INITIALIZATION_SECRET=generate_a_long_random_secret

# Brevo Transactional Email Configuration (Required for production password resets)
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=your_verified_sender_email
BREVO_FROM_NAME=Auto-Zoho
