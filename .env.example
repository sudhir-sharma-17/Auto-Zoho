# Backend App Server Configuration
HOST=127.0.0.1
PORT=8000
ENV=development

# Database Settings
DATABASE_URL=sqlite:///./data/zoho_uploader.db

# Storage Directories
UPLOAD_DIR=./data/uploads
LOGS_DIR=./logs

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173

# Zoho Developer Console Integration
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret

# Zoho endpoints depending on accounts (e.g. .com, .in, .eu)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in/expense/v1

# Cryptographic token encryption key (32-byte urlsafe base64 key)
ZOHO_TOKEN_ENCRYPTION_KEY=generate_a_new_key_locally
